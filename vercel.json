{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>[^.]+)\\.prasanthkathi\\.in"
        }
      ],
      "destination": "/sites/:subdomain/"
    },
    {
      "source": "/((?!sites/).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>[^.]+)\\.prasanthkathi\\.in"
        }
      ],
      "destination": "/sites/:subdomain/$1"
    }
  ]
}