{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>[^.]+)\\.prasanthkathi\\.in"
        }
      ],
      "destination": "/sites/:subdomain/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>[^.]+)\\.prasanthkathi\\.in"
        }
      ],
      "destination": "/sites/:subdomain/:path*"
    }
  ]
}